# Kopirajte v .env (cp .env.example .env) in zamenjajte vse vrednosti.
# Datoteka .env NE sme v Git (je v .gitignore).
# Naključne vrednosti dobite z ukazom:  openssl rand -base64 32

# Podatkovna baza MariaDB
MARIADB_ROOT_PASSWORD=zamenjaj-me-root
MARIADB_DATABASE=sola_is
MARIADB_USER=sola
MARIADB_PASSWORD=zamenjaj-me-aplikacija

# Podpis piškotka seje (najmanj 32 znakov)
SEJA_SKRIVNOST=zamenjaj-me-z-dolgim-nakljucnim-nizom-najmanj-32-znakov

# Geslo za admin@sc-celje.si (ustvari se ob prvem zagonu, najmanj 8 znakov)
ADMIN_GESLO=zamenjaj-me-admin

# Geslo za vse testne učitelje in učence (najmanj 8 znakov)
TESTNO_GESLO=zamenjaj-me-test
